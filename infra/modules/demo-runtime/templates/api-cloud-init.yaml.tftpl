#cloud-config
users:
  - default
  - name: reflo
    system: true
    shell: /usr/sbin/nologin
  - name: reflo-relay
    system: true
    shell: /usr/sbin/nologin
  - name: reflo-redrive
    system: true
    shell: /usr/sbin/nologin
write_files:
  - path: /etc/reflo/tls/api.crt
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${certificate_b64}
  - path: /etc/reflo/tls/api.key
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${private_key_b64}
  - path: /etc/reflo/runtime.env
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${environment_b64}
  - path: /etc/reflo/migration.env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${migration_environment_b64}
  - path: /etc/reflo/relay.env
    owner: root:reflo-relay
    permissions: "0640"
    encoding: b64
    content: ${relay_environment_b64}
  - path: /etc/reflo/redrive.env
    owner: root:reflo-redrive
    permissions: "0640"
    encoding: b64
    content: ${redrive_environment_b64}
  - path: /etc/systemd/system/reflo-api.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Reflo bounded dev API
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=reflo
      Group=reflo
      WorkingDirectory=/opt/reflo/current
      EnvironmentFile=/etc/reflo/runtime.env
      ExecStart=/usr/bin/node /opt/reflo/current/dist/index.js
      Restart=on-failure
      RestartSec=5s
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectHome=true
      ProtectSystem=strict
      ReadWritePaths=/var/lib/reflo
      AmbientCapabilities=CAP_NET_BIND_SERVICE
      CapabilityBoundingSet=CAP_NET_BIND_SERVICE

      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/reflo-relay.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Reflo bounded dev RocketMQ outbox relay
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=reflo-relay
      Group=reflo-relay
      WorkingDirectory=/opt/reflo/current
      EnvironmentFile=/etc/reflo/relay.env
      ExecStart=/usr/bin/node /opt/reflo/current/dist/outbox-relay-main.js
      Restart=on-failure
      RestartSec=5s
      TimeoutStopSec=15s
      KillSignal=SIGTERM
      KillMode=mixed
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectHome=true
      ProtectSystem=strict
      ReadWritePaths=/var/lib/reflo-relay

      [Install]
      WantedBy=multi-user.target
  - path: /usr/local/sbin/reflo-redrive
    owner: root:root
    permissions: "0700"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      if [[ "$#" -ne 6 ]]; then
        echo "invalid redrive invocation" >&2
        exit 64
      fi
      exec systemd-run \
        --quiet \
        --wait \
        --collect \
        --service-type=exec \
        --unit="reflo-redrive-$${RANDOM}-$${RANDOM}" \
        --uid=reflo-redrive \
        --gid=reflo-redrive \
        --property=EnvironmentFile=/etc/reflo/redrive.env \
        --property=NoNewPrivileges=yes \
        --property=PrivateTmp=yes \
        --property=ProtectHome=yes \
        --property=ProtectSystem=strict \
        --property=TimeoutStopSec=15s \
        /usr/bin/node /opt/reflo/current/dist/dlq-redrive-main.js "$@"
runcmd:
  - [sh, -ceu, "umask 077; install -d -o reflo -g reflo /var/lib/reflo; install -d -o reflo-relay -g reflo-relay /var/lib/reflo-relay; install -d /opt/reflo/releases; ossutil cp oss://${artifact_bucket}/${artifact_key} /opt/reflo/api.tar.gz --config-file /dev/null --mode EcsRamRole; echo '${artifact_sha256}  /opt/reflo/api.tar.gz' | sha256sum -c -; mkdir /opt/reflo/releases/${artifact_sha256}; tar -xzf /opt/reflo/api.tar.gz -C /opt/reflo/releases/${artifact_sha256}; chown -R root:root /opt/reflo/releases/${artifact_sha256}; ln -sfn /opt/reflo/releases/${artifact_sha256} /opt/reflo/current; systemctl daemon-reload"]
