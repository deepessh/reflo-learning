#cloud-config
users:
  - default
  - name: reflo
    system: true
    shell: /usr/sbin/nologin
write_files:
  - path: /etc/reflo/tls/api.crt
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${certificate_b64}
  - path: /etc/reflo/tls/api.key
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${private_key_b64}
  - path: /etc/reflo/runtime.env
    owner: root:reflo
    permissions: "0640"
    encoding: b64
    content: ${environment_b64}
  - path: /etc/reflo/migration.env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${migration_environment_b64}
  - path: /etc/systemd/system/reflo-api.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Reflo bounded dev API
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=simple
      User=reflo
      Group=reflo
      WorkingDirectory=/opt/reflo/current
      EnvironmentFile=/etc/reflo/runtime.env
      ExecStart=/usr/bin/node /opt/reflo/current/dist/index.js
      Restart=on-failure
      RestartSec=5s
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectHome=true
      ProtectSystem=strict
      ReadWritePaths=/var/lib/reflo
      AmbientCapabilities=CAP_NET_BIND_SERVICE
      CapabilityBoundingSet=CAP_NET_BIND_SERVICE

      [Install]
      WantedBy=multi-user.target
runcmd:
  - [sh, -ceu, "umask 077; install -d -o reflo -g reflo /var/lib/reflo; install -d /opt/reflo/releases; ossutil cp oss://${artifact_bucket}/${artifact_key} /opt/reflo/api.tar.gz --config-file /dev/null --mode EcsRamRole; echo '${artifact_sha256}  /opt/reflo/api.tar.gz' | sha256sum -c -; mkdir /opt/reflo/releases/${artifact_sha256}; tar -xzf /opt/reflo/api.tar.gz -C /opt/reflo/releases/${artifact_sha256}; chown -R root:root /opt/reflo/releases/${artifact_sha256}; ln -sfn /opt/reflo/releases/${artifact_sha256} /opt/reflo/current; systemctl daemon-reload"]
