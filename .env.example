REFLO_ENV=dev
API_HOST=127.0.0.1
API_PORT=3001
NEXT_PUBLIC_REFLO_ENV=dev
NEXT_PUBLIC_REFLO_API_ORIGIN=http://127.0.0.1:3001

# scripts/local-stack.sh generates ignored database credentials and application
# URLs under .reflo/local-stack. These loopback ports may be overridden before
# the first start; remove that generated directory to regenerate configuration.
REFLO_LOCAL_RDS_PORT=55432
REFLO_LOCAL_VECTOR_PORT=55433
REFLO_LOCAL_WEB_PORT=53000
REFLO_LOCAL_API_PORT=53001
REFLO_LOCAL_JOBS_PORT=53002

# scripts/local-apps.sh creates an ignored mode-0600 runtime.env beside the
# generated database configuration. Put container-visible development provider
# settings there (for example, http://host.docker.internal:4000 on Docker
# Desktop); never bake credentials into an image or tracked file.

# Development smoke adapters only. This literal API key is a non-secret local
# placeholder; replace it through an ignored environment file if your local
# LiteLLM proxy requires a key. These settings are rejected outside REFLO_ENV=dev.
REFLO_LITELLM_BASE_URL=http://127.0.0.1:4000
REFLO_LITELLM_API_KEY=dev-only-placeholder
REFLO_LITELLM_TEXT_MODEL=reflo-local-text
REFLO_LITELLM_EMBEDDING_MODEL=reflo-local-embedding

# Connected development smoke prerequisites. The repository-owned
# `corepack pnpm local-workers:prepare` command writes these non-secret values
# to ignored `.reflo/local-workers/profile.env`; do not hand-edit that file.
# Runtime never downloads worker, signature, tessdata, or voice artifacts.
REFLO_LOCAL_INGESTION_IMAGE=
REFLO_LOCAL_INGESTION_IMAGE_DIGEST=
# Optional import alternative to a local Containerfile build. Both values are
# required together; the bootstrap verifies the archive before `podman load`.
REFLO_LOCAL_INGESTION_ARCHIVE=
REFLO_LOCAL_INGESTION_ARCHIVE_SHA256=
REFLO_LOCAL_CLAMAV_DATABASE_DIR=
REFLO_LOCAL_TESSDATA_DIR=
REFLO_LOCAL_PIPER_PYTHON=
REFLO_LOCAL_PIPER_MODEL_PATH=
REFLO_LOCAL_PIPER_CONFIG_PATH=
REFLO_LOCAL_PIPER_MODEL_SHA256=5d4f08ba6a2a48c44592eed3ce56bf85e9de3dd4e20df90541ae68a8310c029a
REFLO_LOCAL_PIPER_CONFIG_SHA256=7e1f4634af596d83cca997fb7a931ba80b70f8a316a2655ee69c55365e0ace14
REFLO_LOCAL_PIPER_ARTIFACT_REVISION=5b44ec7bab7c5822cfec48fbd5aa99db71a823d6
REFLO_LOCAL_PIPER_VOICE_ARTIFACT_VERSION=piper-voice-en-us-ljspeech-high-v1

# Optional P1 development video experiment. Keep the flag false unless the
# configured fal account and model may be used with synthetic/right-cleared,
# non-PII prompts. The key shown here is a non-secret placeholder.
REFLO_LOCAL_SMOKE_VIDEO=false
REFLO_FAL_KEY=dev-only-placeholder
REFLO_FAL_VIDEO_MODEL=fal-ai/wan/v2.7/text-to-video
REFLO_FAL_MEDIA_LIFETIME_SECONDS=3600

# Auth is disabled by default in dev. The local inbox is development-only and
# must target one staff-controlled address. Staging and pilot require "directmail".
REFLO_AUTH_EMAIL_ADAPTER=disabled
DATABASE_URL=
REFLO_AUTH_CALLBACK_ORIGINS=
REFLO_AUTH_EMAIL_ENCRYPTION_KEY=
REFLO_AUTH_LOOKUP_KEY=
REFLO_AUTH_SESSION_DIGEST_KEY=
REFLO_AUTH_TOKEN_DIGEST_KEY=
REFLO_DEV_AUTH_INBOX_ACCESS_KEY=
REFLO_DEV_AUTH_INBOX_DESTINATION=

# Connected online demo composition is disabled by default. These development-
# only values wire the real repositories and typed LiteLLM router; the seed
# course must already contain rights-cleared ready text and quiz assets.
REFLO_DEMO_OPERATOR_USER_ID=
REFLO_CONNECTED_DEMO_MODE=disabled
REFLO_CONNECTED_DEMO_ARTIFACT_ROOT=
REFLO_CONNECTED_DEMO_BOUNDARY_PROFILE=
# Enables the host-only rootless Podman upload worker. Keep disabled in the
# containerized app profile, which intentionally has no host-runtime authority.
REFLO_DEMO_UPLOAD_PROCESSOR_MODE=disabled
REFLO_MODEL_ADAPTER=
REFLO_VECTOR_DATABASE_URL=
REFLO_DEMO_GRADING_CALIBRATION_EVIDENCE_ID=
REFLO_DEMO_GRADING_CONFIDENCE_THRESHOLD=0.95000
REFLO_DEMO_REVIEW_LOCAL_TIME=09:00
REFLO_DEMO_REVIEW_TIME_ZONE=UTC
REFLO_DEMO_SEED_COURSE_ID=

# The development jobs command executes one existing audio-queue contract and
# exits. Omit the envelope for a bounded readiness check.
REFLO_JOBS_DEV_AUDIO_ENVELOPE=
REFLO_JOBS_DEV_DELIVERY_NUMBER=1
REFLO_JOBS_HANDLER_TIMEOUT_MS=30000

# DirectMail production eligibility and sender configuration.
REFLO_DIRECTMAIL_ELIGIBILITY=
REFLO_DIRECTMAIL_REGION=
REFLO_DIRECTMAIL_RAM_ROLE_NAME=
REFLO_DIRECTMAIL_SENDER_ADDRESS=
REFLO_DIRECTMAIL_FROM_ALIAS=
REFLO_DIRECTMAIL_DAILY_LIMIT=200
REFLO_DIRECTMAIL_TOTAL_LIMIT=2000

# P0 delivery is disabled in local development by default. Staging/demo
# deployments use only explicitly provisioned staff-controlled identities.
REFLO_DEMO_DELIVERY_MODE=disabled
REFLO_DEMO_DESTINATION_LOOKUP_KEY=
REFLO_DEMO_EMAIL_LINK_SIGNING_KEY=
REFLO_DEMO_EMAIL_LINK_ORIGIN=
REFLO_DEMO_EMAIL_CHANNEL_ID=
REFLO_DEMO_EMAIL_OWNER_SCOPE_ID=
REFLO_DEMO_EMAIL_USER_ID=
REFLO_DEMO_EMAIL_DESTINATION=
REFLO_DEMO_TELEGRAM_CHANNEL_ID=
REFLO_DEMO_TELEGRAM_OWNER_SCOPE_ID=
REFLO_DEMO_TELEGRAM_USER_ID=
REFLO_DEMO_TELEGRAM_DESTINATION=
REFLO_DEMO_TELEGRAM_BOT_TOKEN=
REFLO_DEMO_TELEGRAM_WEBHOOK_SECRET=

# Demo observability is disabled until both sinks and a non-learner rehearsal
# run identifier are configured. Staging/pilot credentials are injected from
# KMS-backed runtime secrets; never place real keys in this file.
REFLO_DEMO_TRACING_MODE=disabled
REFLO_DEMO_TRACE_RUN_ID=
REFLO_LANGFUSE_BASE_URL=
REFLO_LANGFUSE_PUBLIC_KEY=
REFLO_LANGFUSE_SECRET_KEY=
REFLO_SLS_OTEL_ENDPOINT=
REFLO_SLS_PROJECT=
REFLO_SLS_TRACE_INSTANCE_ID=
REFLO_SLS_ACCESS_KEY_ID=
REFLO_SLS_ACCESS_KEY_SECRET=
