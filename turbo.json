{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env.example",
    ".prettierignore",
    "eslint.config.mjs",
    "packages/tsconfig/*.json"
  ],
  "globalEnv": [
    "NEXT_PUBLIC_REFLO_API_ORIGIN",
    "NEXT_PUBLIC_REFLO_ENV",
    "REFLO_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "REFLO_LITELLM_API_KEY",
        "REFLO_LITELLM_BASE_URL",
        "REFLO_LITELLM_EMBEDDING_MODEL",
        "REFLO_LITELLM_TEXT_MODEL",
        "REFLO_AUTH_CALLBACK_ORIGINS",
        "REFLO_AUTH_EMAIL_ADAPTER",
        "REFLO_AUTH_EMAIL_ENCRYPTION_KEY",
        "REFLO_AUTH_LOOKUP_KEY",
        "REFLO_AUTH_SESSION_DIGEST_KEY",
        "REFLO_AUTH_TOKEN_DIGEST_KEY",
        "REFLO_CONNECTED_DEMO_ARTIFACT_ROOT",
        "REFLO_CONNECTED_DEMO_BOUNDARY_PROFILE",
        "REFLO_CONNECTED_DEMO_MODE",
        "REFLO_DEMO_GRADING_CALIBRATION_EVIDENCE_ID",
        "REFLO_DEMO_GRADING_CONFIDENCE_THRESHOLD",
        "REFLO_DEMO_OPERATOR_OWNER_SCOPE_ID",
        "REFLO_DEMO_OPERATOR_USER_ID",
        "REFLO_DEMO_REVIEW_LOCAL_TIME",
        "REFLO_DEMO_REVIEW_TIME_ZONE",
        "REFLO_DEMO_SEED_COURSE_ID",
        "REFLO_DEV_AUTH_INBOX_ACCESS_KEY",
        "REFLO_DEV_AUTH_INBOX_DESTINATION",
        "REFLO_DIRECTMAIL_DAILY_LIMIT",
        "REFLO_DIRECTMAIL_ELIGIBILITY",
        "REFLO_DIRECTMAIL_FROM_ALIAS",
        "REFLO_DIRECTMAIL_RAM_ROLE_NAME",
        "REFLO_DIRECTMAIL_REGION",
        "REFLO_DIRECTMAIL_SENDER_ADDRESS",
        "REFLO_DIRECTMAIL_TOTAL_LIMIT",
        "REFLO_DEMO_DELIVERY_MODE",
        "REFLO_DEMO_DESTINATION_LOOKUP_KEY",
        "REFLO_DEMO_EMAIL_LINK_SIGNING_KEY",
        "REFLO_DEMO_EMAIL_LINK_ORIGIN",
        "REFLO_DEMO_EMAIL_CHANNEL_ID",
        "REFLO_DEMO_EMAIL_OWNER_SCOPE_ID",
        "REFLO_DEMO_EMAIL_USER_ID",
        "REFLO_DEMO_EMAIL_DESTINATION",
        "REFLO_DEMO_TELEGRAM_CHANNEL_ID",
        "REFLO_DEMO_TELEGRAM_OWNER_SCOPE_ID",
        "REFLO_DEMO_TELEGRAM_USER_ID",
        "REFLO_DEMO_TELEGRAM_DESTINATION",
        "REFLO_DEMO_TELEGRAM_BOT_TOKEN",
        "REFLO_DEMO_TELEGRAM_WEBHOOK_SECRET",
        "REFLO_DEMO_TRACING_MODE",
        "REFLO_DEMO_TRACE_RUN_ID",
        "REFLO_DEMO_UPLOAD_MALWARE_SCANNER_MODE",
        "REFLO_DEMO_UPLOAD_PROCESSOR_MODE",
        "REFLO_LANGFUSE_BASE_URL",
        "REFLO_LANGFUSE_PUBLIC_KEY",
        "REFLO_LANGFUSE_SECRET_KEY",
        "REFLO_JOBS_DEV_AUDIO_ENVELOPE",
        "REFLO_JOBS_DEV_DELIVERY_NUMBER",
        "REFLO_JOBS_HANDLER_TIMEOUT_MS",
        "REFLO_LOCAL_CLAMAV_ADMISSION_DATABASE_DIR",
        "REFLO_LOCAL_CLAMAV_DATABASE_DIR",
        "REFLO_LOCAL_CLAMAV_MANIFEST_PATH",
        "REFLO_LOCAL_CLAMAV_PUBLIC_KEY_KID",
        "REFLO_LOCAL_CLAMAV_PUBLIC_KEY_PATH",
        "REFLO_LOCAL_CLAMAV_PUBLIC_KEY_SPKI_SHA256",
        "REFLO_LOCAL_CLAMAV_SCANNER_IMAGE",
        "REFLO_LOCAL_CLAMAV_SIGNATURE_PATH",
        "REFLO_LOCAL_INGESTION_IMAGE",
        "REFLO_LOCAL_INGESTION_IMAGE_DIGEST",
        "REFLO_LOCAL_TESSDATA_DIR",
        "REFLO_MODEL_ADAPTER",
        "REFLO_SLS_ACCESS_KEY_ID",
        "REFLO_SLS_ACCESS_KEY_SECRET",
        "REFLO_SLS_OTEL_ENDPOINT",
        "REFLO_SLS_PROJECT",
        "REFLO_SLS_TRACE_INSTANCE_ID",
        "REFLO_VECTOR_DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "REFLO_POSTGRES_CONTAINER_ID",
        "REFLO_POSTGRES_CONTAINER_REWRITE_FROM",
        "REFLO_POSTGRES_CONTAINER_REWRITE_TO",
        "REFLO_SKIP_SCHEMA_DUMP",
        "TEST_DATABASE_URL"
      ],
      "outputs": []
    }
  }
}
