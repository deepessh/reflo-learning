{
  "name": "@reflo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "schema.sql",
    "scripts",
    "sql"
  ],
  "scripts": {
    "build": "node scripts/check-migrations.mjs && tsc -p tsconfig.build.json",
    "db:dump": "scripts/dump-schema-from-container.sh",
    "db:migrate": "node scripts/strict-migrate.mjs",
    "flow-b:database": "node scripts/create-connected-flow-b-database.mjs",
    "flow-b:development-profile": "node scripts/apply-connected-flow-b-development-profile.mjs",
    "flow-b:prepare": "node scripts/prepare-connected-flow-b.mjs",
    "lint": "eslint scripts src test",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@reflo/accounts": "workspace:*",
    "@reflo/activation": "workspace:*",
    "@reflo/assessment": "workspace:*",
    "@reflo/audio": "workspace:*",
    "@reflo/delivery": "workspace:*",
    "@reflo/evaluation": "workspace:*",
    "@reflo/ingestion": "workspace:*",
    "@reflo/knowledge-model": "workspace:*",
    "@reflo/model-router": "workspace:*",
    "@reflo/retrieval": "workspace:*",
    "@reflo/tutor-agent": "workspace:*",
    "dbmate": "2.34.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
